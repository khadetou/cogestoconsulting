{
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "archive.cogestoconsulting.com"
        }
      ],
      "destination": "/wp-archive-proxy"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "archive.cogestoconsulting.com"
        }
      ],
      "destination": "/wp-archive-proxy/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cogestoconsulting.com"
        }
      ],
      "destination": "https://www.cogestoconsulting.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cogestoconsulting.com"
        }
      ],
      "destination": "https://www.cogestoconsulting.com/:path*",
      "permanent": true
    },
